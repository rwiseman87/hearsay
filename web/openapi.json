    "/api/settings/reveal": {
      "post": {
        "tags": [
          "settings"
        ],
        "summary": "Open the effective recordings directory in the OS file manager. Runs in the core (a native\nprocess in the user's login session), reached over the same-origin HTTP API the rest of Settings\nuses — the desktop shell's Tauri `invoke()` is not reliably reachable from the webview's remote\nloopback origin, so the \"Reveal data folder\" button routes here instead. On failure the reason is\nsurfaced to the client (not collapsed to a generic 500) so a broken reveal is diagnosable.",
        "operationId": "reveal_output_dir",
        "responses": {
          "204": {
            "description": ""
          },
          "503": {
            "description": ""
          }
        }
      }
    },
