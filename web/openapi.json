  "components": {
    "schemas": {
      "AboutInfo": {
        "type": "object",
        "description": "Read-only build/runtime facts for the About panel (`protocol_version` is the core's IPC\nframe-protocol constant; a mismatch with the helper's reported copy signals version drift).",
        "required": [
          "app_version",
          "environment",
          "protocol_version",
          "database_path"
        ],
        "properties": {
          "app_version": {
            "type": "string"
          },
          "database_path": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "protocol_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "IdentityRead": {
        "type": "object",
        "description": "A known cross-meeting person (offered as a rename suggestion).",
        "required": [
          "id",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MeetingCreate": {
        "type": "object",
        "description": "Start a meeting. `title` defaults to a timestamp-derived name when omitted.",
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MeetingRead": {
        "type": "object",
        "description": "A meeting row for the API.",
        "required": [
          "id",
          "title",
          "folder",
          "status",
          "started_at",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "folder": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/MeetingStatus"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MeetingStatus": {
        "type": "string",
        "description": "Lifecycle state of a meeting (lowercase on the wire, matching the Python `StrEnum`).",
        "enum": [
          "recording",
          "finalized"
        ]
      },
      "Page_IdentityRead": {
        "type": "object",
        "description": "Paginated list envelope used by every list endpoint (`{ total, page, page_size, items }`).",
        "required": [
          "total",
          "page",
          "page_size",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A known cross-meeting person (offered as a rename suggestion).",
              "required": [
                "id",
                "display_name"
              ],
              "properties": {
                "display_name": {
                  "type": "string"
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Page_MeetingRead": {
        "type": "object",
        "description": "Paginated list envelope used by every list endpoint (`{ total, page, page_size, items }`).",
        "required": [
          "total",
          "page",
          "page_size",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A meeting row for the API.",
              "required": [
                "id",
                "title",
                "folder",
                "status",
                "started_at",
                "created_at",
                "updated_at"
              ],
              "properties": {
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "ended_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "folder": {
                  "type": "string"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "$ref": "#/components/schemas/MeetingStatus"
                },
                "title": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Page_SegmentRead": {
        "type": "object",
        "description": "Paginated list envelope used by every list endpoint (`{ total, page, page_size, items }`).",
        "required": [
          "total",
          "page",
          "page_size",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A transcript segment for the API.",
              "required": [
                "id",
                "stream",
                "speaker_label",
                "text",
                "start_s",
                "end_s"
              ],
              "properties": {
                "cluster_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "end_s": {
                  "type": "number",
                  "format": "double"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "speaker_label": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "format": "double"
                },
                "stream": {
                  "$ref": "#/components/schemas/Stream"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Page_SpeakerRead": {
        "type": "object",
        "description": "Paginated list envelope used by every list endpoint (`{ total, page, page_size, items }`).",
        "required": [
          "total",
          "page",
          "page_size",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A diarization cluster within a meeting, with its resolved display label.",
              "required": [
                "id",
                "ordinal",
                "label",
                "locked"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The cluster id."
                },
                "identity_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "label": {
                  "type": "string",
                  "description": "The bound identity's name, else `\"Speaker {ordinal}\"`."
                },
                "locked": {
                  "type": "boolean"
                },
                "ordinal": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PermissionsInfo": {
        "type": "object",
        "description": "Live TCC permission status probed from the capture helper (not a stored preference). Each field\nis `granted` / `denied` / `undetermined`, or `unknown` when the helper is unavailable.\n`helper_version` is the connected helper's build (`None` when unavailable).",
        "required": [
          "helper_available",
          "microphone",
          "audio_capture",
          "screen_recording",
          "accessibility",
          "calendar"
        ],
        "properties": {
          "accessibility": {
            "type": "string"
          },
          "audio_capture": {
            "type": "string"
          },
          "calendar": {
            "type": "string"
          },
          "helper_available": {
            "type": "boolean"
          },
          "helper_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "microphone": {
            "type": "string"
          },
          "screen_recording": {
            "type": "string"
          }
        }
      },
      "RecordingSettings": {
        "type": "object",
        "description": "Recording & privacy — the single audio-retention switch (keep one WAV per meeting for playback\n+ the post-meeting refine). Editable section; a request body and part of [`SettingsRead`].",
        "required": [
          "record"
        ],
        "properties": {
          "record": {
            "type": "boolean"
          }
        }
      },
      "SegmentRead": {
        "type": "object",
        "description": "A transcript segment for the API.",
        "required": [
          "id",
          "stream",
          "speaker_label",
          "text",
          "start_s",
          "end_s"
        ],
        "properties": {
          "cluster_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "end_s": {
            "type": "number",
            "format": "double"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "speaker_label": {
            "type": "string"
          },
          "start_s": {
            "type": "number",
            "format": "double"
          },
          "stream": {
            "$ref": "#/components/schemas/Stream"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "SettingsRead": {
        "type": "object",
        "description": "The full editable settings, one field per panel/section. `storage_info` and `about` are\nread-only context (not editable sections).",
        "required": [
          "recording",
          "speakers",
          "storage",
          "storage_info",
          "about"
        ],
        "properties": {
          "about": {
            "$ref": "#/components/schemas/AboutInfo"
          },
          "recording": {
            "$ref": "#/components/schemas/RecordingSettings"
          },
          "speakers": {
            "$ref": "#/components/schemas/SpeakerSettings"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageSettings"
          },
          "storage_info": {
            "$ref": "#/components/schemas/StorageInfo"
          }
        }
      },
      "SpeakerRead": {
        "type": "object",
        "description": "A diarization cluster within a meeting, with its resolved display label.",
        "required": [
          "id",
          "ordinal",
          "label",
          "locked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The cluster id."
          },
          "identity_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "description": "The bound identity's name, else `\"Speaker {ordinal}\"`."
          },
          "locked": {
            "type": "boolean"
          },
          "ordinal": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SpeakerRename": {
        "type": "object",
        "description": "Rename a cluster to a person (binds + locks; relabels that speaker's segments).",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          }
        }
      },
      "SpeakerSettings": {
        "type": "object",
        "description": "Speaker diarization: re-diarize each meeting at finalize (`auto_refine`) + the cosine at/above\nwhich a refined speaker is auto-matched to a person named in a prior meeting.",
        "required": [
          "auto_refine",
          "recognition_threshold"
        ],
        "properties": {
          "auto_refine": {
            "type": "boolean"
          },
          "recognition_threshold": {
