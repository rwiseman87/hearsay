{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearsay",
  "version": "0.1.0",
  "identifier": "com.hearsay.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hearsay",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hearsay-core",
      "binaries/hearsay-notes",
      "binaries/hearsay-helper",
      "binaries/hearsay-live",
      "binaries/hearsay-me",
      "binaries/hearsay-diarize",
      "binaries/hearsay-models"
    ],
    "resources": {
      "../dist": "web-dist",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "14.4",
      "hardenedRuntime": false,
      "signingIdentity": "-"
    }
  }
}
